{
  "private": true,
  "scripts": {
    "build": "spago build --pedantic-packages",
    "test": "spago test --pedantic-packages",
    "lint": "oxlint src test",
    "format": "purs-tidy format-in-place src test && oxfmt --write 'src/**/*.js'",
    "format:check": "purs-tidy check src test && oxfmt --check 'src/**/*.js'"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "purescript": "0.15.16",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4"
  }
}
